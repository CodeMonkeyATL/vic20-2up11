root = true

# vic-20 basic v2 files
[*.bas]

# treat as plain text
indent_style = space
indent_size = 4

# disable all automatic formatting and normalization
dotnet_sort_system_directives_first = false
dotnet_style_predefined_type_for_locals_parameters_members = false
dotnet_style_predefined_type_for_member_access = false
dotnet_style_qualification_for_field = false
dotnet_style_qualification_for_property = false
dotnet_style_qualification_for_method = false
dotnet_style_qualification_for_event = false

# disable vb keyword normalization (prevents auto-capitalization)
visual_basic_style_predefined_type_for_locals_parameters_members = false
visual_basic_style_predefined_type_for_member_access = false

# disable c# var rules (VS applies these globally unless overridden)
csharp_style_var_for_built_in_types = false
csharp_style_var_for_locals = false

# disable format-on-type behavior
trim_trailing_whitespace = false
insert_final_newline = false
end_of_line = lf
